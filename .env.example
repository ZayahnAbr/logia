# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings > API: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ── AI providers ────────────────────────────────────────────────────────────
# Logia pools several providers and fails over between them (see AI-PLAN.md).
# Only GROQ_API_KEY is required. Each extra key adds capacity.
# Check every provider's commercial-use and data-retention terms before relying on it.

# Groq: chat, vision and audio. https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Groq with billing enabled, used only for Pro students so they never
# compete with free students for the free allowances. Optional.
GROQ_PAID_API_KEY=

# NVIDIA NIM: extra chat capacity, and a fallback for reading photos.
# https://build.nvidia.com  (the free limit is per account, not per model)
NVIDIA_API_KEY=
# Only if the vision model has its own key. Otherwise NVIDIA_API_KEY is used.
NVIDIA_VISION_API_KEY=
# Optional overrides. Defaults: openai/gpt-oss-120b and the address below.
NVIDIA_MODEL=
NVIDIA_VISION_MODEL=
NVIDIA_BASE_URL=

# Cerebras: large daily allowance, few requests a minute, so it suits big jobs.
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Cloudflare Workers AI: cheap failover. Both values are needed.
# https://dash.cloudflare.com
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
